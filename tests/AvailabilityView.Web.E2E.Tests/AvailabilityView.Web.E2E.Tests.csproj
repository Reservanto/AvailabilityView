<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testy v prohlížeči: Chromium a axe-core nad aplikací na Kestrelu. Mají trait E2E, rychlá vrstva je nespouští.
    Chromium se instaluje jednorázově: pwsh bin/Debug/net10.0/playwright.ps1 install chromium.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AvailabilityView.Web\AvailabilityView.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
