<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>availabilityview-web</UserSecretsId>
  </PropertyGroup>

  <!--
    Frontend se překládá při dotnet build, bez Node: SCSS → wwwroot/css (sekce SassCompiler v appsettings.json),
    TypeScript → wwwroot/js (tsconfig.json). MSBuild předává tsc vlastní cíl a source mapy, proto jsou tady.
    pretty false = chyby tsc v kanonickém formátu, kterým MSBuild shodí build.
  -->
  <PropertyGroup>
    <TypeScriptTarget>ES2017</TypeScriptTarget>
    <TypeScriptSourceMap>false</TypeScriptSourceMap>
    <TypeScriptAdditionalFlags>--pretty false</TypeScriptAdditionalFlags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="tsconfig.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvailabilityView.Application\AvailabilityView.Application.csproj" />
    <ProjectReference Include="..\AvailabilityView.Infrastructure\AvailabilityView.Infrastructure.csproj" />
  </ItemGroup>

</Project>
