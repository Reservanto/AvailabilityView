<?xml version="1.0" encoding="utf-8"?>
<!-- Nastavení pro IIS (docs/instalace-iis.md). Publikace soubor převezme a doplní cestu k aplikaci. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\AvailabilityView.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- Hlášky a stránku 429 posílá aplikace sama. IIS je nenahradí vlastní chybovou stránkou, ani když to má
           server nastavené pro všechny weby. -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
